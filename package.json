{
  "name": "plataforma-chome",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 -p 3001",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:secrets": "tsx scripts/check-env-files.ts",
    "perf:queries": "tsx scripts/measure-operational-queries.ts",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "e2e:setup": "tsx e2e/setup-db.ts",
    "screenshots": "tsx --env-file=.env.local scripts/capture-all-routes.ts",
    "test": "vitest run",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:fast": "vitest run --config vitest.non-pglite.config.ts",
    "test:pglite": "vitest run --config vitest.pglite.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "next experimental-analyze",
    "release": "tsx scripts/release.ts",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@sentry/nextjs": "^10.59.0",
    "@tanstack/react-query": "^5.101.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "geist": "^1.7.2",
    "jspdf": "^4.2.1",
    "next": "^16.2.9",
    "next-auth": "5.0.0-beta.31",
    "playwright": "^1.60.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "resend": "^6.14.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@electric-sql/pglite": "^0.5.2",
    "@next/env": "^16.2.9",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "postcss": "8.5.15",
    "uuid": "11.1.1"
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1"
    }
  }
}
