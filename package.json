{
  "name": "plataforma-chome",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 -p 3001",
    "build": "bash scripts/run-resource-guard.sh next build --webpack",
    "start": "node .next/standalone/server.js",
    "lint": "bash scripts/run-resource-guard.sh eslint",
    "typecheck": "bash scripts/run-resource-guard.sh tsc --noEmit --incremental false",
    "check:secrets": "tsx scripts/check-env-files.ts",
    "check:security-audit": "tsx scripts/check-security-audit.ts",
    "verify:epp-lots": "tsx scripts/verify-epp-lot-reconciliation.ts",
    "db:preflight-invoice-reconciliation": "tsx --env-file-if-exists=.env.local scripts/preflight-purchase-invoice-reconciliation.ts",
    "db:verify-invoice-allocations": "tsx --env-file-if-exists=.env.local scripts/verify-purchase-invoice-allocations.ts",
    "db:backfill-invoice-reconciliation": "tsx --env-file-if-exists=.env.local scripts/backfill-purchase-invoice-reconciliation.ts",
    "db:backfill-fuel-meter-readings": "tsx --env-file-if-exists=.env.local scripts/backfill-fuel-meter-readings.ts",
    "db:prepare-rollback-invoice-reconciliation": "tsx --env-file-if-exists=.env.local scripts/rollback-purchase-invoice-reconciliation-statuses.ts",
    "db:preflight-dte-enrichment": "tsx --env-file-if-exists=.env.local scripts/preflight-dte-line-enrichment.ts",
    "db:enrich-purchase-dtes": "tsx --env-file-if-exists=.env.local scripts/enrich-historical-purchase-dtes.ts",
    "check:drizzle-aliases": "bash scripts/check-drizzle-aliases.sh",
    "check:bundle-budget": "tsx scripts/check-bundle-budget.ts",
    "check:mistyped-requests": "tsx scripts/check-mistyped-requests.ts",
    "db:diagnose-delivery-quantities": "tsx --env-file-if-exists=.env.local scripts/diagnose-delivery-quantities.ts",
    "db:verify-migrations": "node scripts/verify-migration-chain.mjs",
    "perf:queries": "tsx scripts/measure-operational-queries.ts",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:reconcile-watermarks": "node --env-file-if-exists=.env.local scripts/reconcile-migration-watermarks.mjs",
    "pdtp:backfill-activity-catalog": "tsx --env-file-if-exists=.env.local scripts/backfill-pdtp-catalog-activities.ts",
    "db:migrate": "npm run db:preflight-pdtp-annual && npm run db:preflight-migrations && node --env-file-if-exists=.env.local scripts/migrate.mjs && npm run db:seed-size-catalog && npm run db:reconcile-epp-delivery-scale",
    "db:reconcile-epp-delivery-scale": "tsx --env-file-if-exists=.env.local scripts/reconcile-epp-delivery-scale.ts --apply",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local db/seed.ts",
    "db:seed-pdtp-inspection-templates": "tsx --env-file=.env.local scripts/seed-pdtp-inspection-templates-2026.ts",
    "db:apply-sst-taxonomy": "tsx --env-file-if-exists=.env.local scripts/apply-sst-document-taxonomy.ts",
    "db:seed-document-root-folders": "tsx --env-file=.env.local scripts/seed-document-root-folders.ts",
    "db:preflight-worker-sizes": "tsx --env-file-if-exists=.env.local scripts/preflight-worker-sizes.ts",
    "db:preflight-epp-family-backfill": "tsx --env-file-if-exists=.env.local scripts/preflight-epp-family-backfill.ts",
    "db:seed-size-catalog": "tsx --env-file-if-exists=.env.local scripts/seed-size-catalog.ts",
    "db:seed-fuel-anomaly-rules": "tsx --env-file-if-exists=.env.local scripts/seed-fuel-anomaly-rules.ts",
    "db:seed-emergency-plans": "tsx --env-file-if-exists=.env.local scripts/seed-prevention-emergency-plans.ts",
    "db:seed-cphs-orientation-course": "tsx --env-file=.env.local scripts/seed-prevention-cphs-orientation-course.ts",
    "pdtp:apply-all": "bash scripts/apply-pdtp-data.sh",
    "pdtp:apply-catalog-decisions": "tsx --env-file=.env.local scripts/apply-pdtp-2026-catalog-decisions.ts",
    "pdtp:apply-worksite-scope": "tsx --env-file=.env.local scripts/apply-pdtp-2026-worksite-scope.ts",
    "pdtp:apply-mechanisms": "tsx --env-file=.env.local scripts/apply-pdtp-2026-mechanisms.ts",
    "pdtp:apply-program-data": "tsx --env-file=.env.local scripts/apply-pdtp-2026-program-data.ts",
    "pdtp:apply-demand-slas": "tsx --env-file=.env.local scripts/apply-pdtp-2026-demand-slas.ts",
    "pdtp:seed-course-versions": "tsx --env-file=.env.local scripts/seed-pdtp-2026-course-versions.ts",
    "pdtp:resign-inspection-templates": "tsx --env-file=.env.local scripts/resign-pdtp-2026-inspection-templates.ts",
    "pdtp:reclassify-specific-courses": "tsx --env-file=.env.local scripts/reclassify-pdtp-2026-specific-courses.ts",
    "pdtp:approve-inspection-templates": "tsx --env-file=.env.local scripts/approve-pdtp-2026-inspection-templates.ts",
    "pdtp:reconcile-fulfillment-events": "tsx --env-file=.env.local scripts/reconcile-pdtp-fulfillment-events.ts",
    "pdtp:bootstrap-2026": "tsx --env-file=.env.local scripts/bootstrap-pdtp-2026.ts",
    "pdtp:reconcile-annual": "tsx --env-file=.env.local scripts/reconcile-pdtp-annual-programs.ts",
    "pdtp:reprogram-2026-schedule": "tsx --env-file=.env.local scripts/reprogram-pdtp-2026-schedule.ts",
    "db:preflight-pdtp-annual": "tsx --env-file-if-exists=.env.local scripts/reconcile-pdtp-annual-programs.ts --apply",
    "db:preflight-migrations": "node --env-file-if-exists=.env.local scripts/migration-preflight.mjs",
    "db:preflight-dte-single-link": "tsx --env-file-if-exists=.env.local scripts/preflight-dte-single-link.ts",
    "db:preflight-fuel-integrations": "tsx --env-file-if-exists=.env.local scripts/preflight-fuel-integrations.ts",
    "db:preflight-pdtp-wiring": "tsx --env-file-if-exists=.env.local scripts/preflight-pdtp-accreditation-wiring.ts",
    "db:preflight-inspection-na-scale": "tsx --env-file-if-exists=.env.local scripts/preflight-inspection-na-scale.ts",
    "inspections:reconcile-history": "tsx --env-file-if-exists=.env.local scripts/reconcile-inspection-history.ts",
    "db:repair-dte-single-link": "tsx --env-file-if-exists=.env.local scripts/repair-dte-single-link.ts",
    "db:diagnose-orphan-stock": "tsx --env-file=.env.local scripts/diagnose-orphan-stock.ts",
    "db:normalize-epp-families": "tsx --env-file=.env.local scripts/normalize-epp-families.ts",
    "db:backfill-epp-clothing-sizes": "tsx --env-file-if-exists=.env.local scripts/backfill-epp-clothing-sizes.ts",
    "db:normalize-fuel-suppliers": "tsx --env-file=.env.local scripts/normalize-fuel-suppliers.ts",
    "db:sync-rbac": "tsx --env-file=.env.local scripts/sync-rbac.ts",
    "forms:overlay-grid": "tsx scripts/overlay-form-grid.ts",
    "db:studio": "drizzle-kit studio",
    "e2e:setup": "tsx e2e/setup-db.ts",
    "screenshots": "bash scripts/run-resource-guard.sh tsx scripts/capture-all-routes.ts",
    "ss": "bash scripts/run-resource-guard.sh tsx scripts/capture-all-routes.ts",
    "ss:full": "bash scripts/run-resource-guard.sh tsx scripts/capture-all-routes.ts --full",
    "ss:modals": "bash scripts/run-resource-guard.sh tsx scripts/capture-all-routes.ts --modals",
    "ss:tabs": "bash scripts/run-resource-guard.sh tsx scripts/capture-all-routes.ts --tabs",
    "ss:interactive": "bash scripts/run-resource-guard.sh tsx scripts/capture-all-routes.ts --interactive",
    "test": "bash scripts/run-resource-guard.sh vitest run",
    "test:e2e": "BODEGA_NODE_HEAP_MB=${BODEGA_NODE_HEAP_MB:-8192} bash scripts/run-resource-guard.sh bash scripts/run-e2e.sh",
    "test:e2e:ui": "BODEGA_NODE_HEAP_MB=8192 bash scripts/run-resource-guard.sh playwright test --ui",
    "test:fast": "bash scripts/run-resource-guard.sh vitest run --config vitest.non-pglite.config.ts",
    "test:pglite": "bash scripts/run-resource-guard.sh vitest run --config vitest.pglite.config.ts",
    "test:watch": "bash scripts/run-resource-guard.sh vitest",
    "test:coverage": "bash scripts/run-resource-guard.sh vitest run --coverage",
    "test:coverage:unit": "bash scripts/run-resource-guard.sh vitest run --coverage --reporter=blob --reporter=default --outputFile.blob=.vitest-reports/unit.json",
    "test:coverage:pglite": "bash scripts/run-resource-guard.sh vitest run --config vitest.pglite.config.ts --coverage --reporter=blob --reporter=default --outputFile.blob=.vitest-reports/pglite.json",
    "test:coverage:merge": "bash scripts/run-resource-guard.sh vitest --config vitest.merged.config.ts --mergeReports=.vitest-reports --coverage",
    "test:coverage:all": "npm run test:coverage:unit && npm run test:coverage:pglite && npm run test:coverage:merge",
    "analyze": "bash scripts/run-resource-guard.sh next experimental-analyze",
    "release": "bash scripts/run-resource-guard.sh tsx scripts/release.ts",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "doctor": "bash scripts/run-resource-guard.sh npx react-doctor@latest"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@tanstack/react-query": "^5.101.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "geist": "^1.7.2",
    "jspdf": "^4.2.1",
    "maplibre-gl": "^6.9.0",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.60.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "resend": "^6.14.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "takumi-pdf": "^0.14.2",
    "tesseract.js": "^5.1.1",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@electric-sql/pglite": "^0.5.2",
    "@next/env": "^16.2.12",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "postcss": "8.5.24",
    "uuid": "11.1.1",
    "nanoid": "^3.3.18"
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "cli-progress@3.12.0": true,
    "core-js@3.49.0": true,
    "sharp@0.34.5": true,
    "tesseract.js@5.1.1": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true
  }
}
