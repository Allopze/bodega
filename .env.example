# ─────────────────────────────────────────────────────────────────────────────
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia a .env.local y rellena los valores de tu entorno.
# [REQUERIDA] = el sistema no arranca sin ella.
# [Opcional]  = tiene valor por defecto en el código.
# ─────────────────────────────────────────────────────────────────────────────


# ── App ──────────────────────────────────────────────────────────────────────
# [Opcional] URL pública canónica. Se usa en links de correo y generación de PDF
# cuando la request no lleva host. Por defecto infiere el origen de la request.
APP_URL=http://localhost:3000

# [Opcional] URL base para NextAuth. AUTH_URL tiene precedencia sobre NEXTAUTH_URL.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# [REQUERIDA] Clave de firma y cifrado de sesión. Mínimo 32 caracteres.
# Genera con: openssl rand -hex 32
AUTH_SECRET=


# ── Base de datos ─────────────────────────────────────────────────────────────
#
# Despliegue Docker self-contained (docker-compose con servicio `db`):
#   NO definas DATABASE_URL. Basta con POSTGRES_PASSWORD; el compose deriva
#   DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
#   y un servicio `migrate` aplica las migraciones antes de levantar la app.
POSTGRES_USER=bodega
POSTGRES_PASSWORD=
POSTGRES_DB=bodega
#
# DB gestionada/externa o desarrollo local: define DATABASE_URL explícito (tiene
# prioridad sobre lo anterior). Dos formatos:
#   TCP con usuario/contraseña: postgres://USER:PASS@HOST:5432/bodega
#   Unix socket (peer auth):    postgres:///bodega
# DATABASE_URL=postgres:///bodega

# [Opcional] Ruta del socket Unix de PostgreSQL. Solo necesaria con peer auth
# (desarrollo local). No aplica al contenedor. Habitual en Debian/Ubuntu:
# PGHOST=/var/run/postgresql


# ── Correo electrónico (Resend) ───────────────────────────────────────────────
# [Opcional] Clave de API de Resend (https://resend.com/api-keys).
# Sin esta variable el sistema arranca pero queda silencioso (no envía correos).
# El remitente fijo es plataforma@portalchome.cl (dominio verificado en Resend).
# El interruptor global en /admin/correo-smtp también puede pausar los envíos.
RESEND_API_KEY=


# ── Almacenamiento de archivos ────────────────────────────────────────────────
# [Opcional] Ruta absoluta del volumen de adjuntos.
# Dev local: déjalo vacío → usa ./storage/
# Producción: ruta persistente fuera del contenedor, p.ej. /data/storage
STORAGE_PATH=


# ── Negocio ───────────────────────────────────────────────────────────────────
# [Opcional] Tasa de IVA como decimal. Por defecto 0.19 (19 % — Chile).
TAX_RATE=0.19

# [Opcional] Máximo de contextos Playwright activos para generación de PDF.
# Por defecto 2. Aumenta en máquinas con más RAM; reduce si ves OOM bajo carga.
PDF_MAX_CONCURRENT=2


# ── Observabilidad ────────────────────────────────────────────────────────────
# [Opcional] DSN de Sentry. Vacío = tracking deshabilitado.
SENTRY_DSN=


# ── Seed (configuración inicial de la BD) ────────────────────────────────────
# Solo se usa al correr: pnpm db:seed
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@example.cl
# [REQUERIDA en producción] Contraseña del administrador inicial.
SEED_ADMIN_PASSWORD=
# false en producción. true solo en dev/CI donde se acepta una contraseña débil.
SEED_ALLOW_DEFAULT_PASSWORD=false
# true: ejecuta el seed en modo dry-run (valida sin escribir en la BD).
SEED_DRY_RUN=false


# ── E2E — Playwright ──────────────────────────────────────────────────────────
# [Opcional] BD separada para las pruebas E2E (playwright.config.ts).
# Vacío = usa DATABASE_URL. En CI usar una base dedicada para evitar que las
# pruebas vacíen datos de desarrollo: E2E_DATABASE_URL=postgres:///bodega_e2e
E2E_DATABASE_URL=

# E2E_ALLOW_DESTRUCTIVE_RESET — inyectado por playwright.config.ts automáticamente.
# E2E_PORT            — inyectado por playwright.config.ts automáticamente.


# ── CI — pruebas de concurrencia e integración ────────────────────────────────
# Solo necesarias en CI. Cada suite destructiva requiere su propia BD.
#
# STOCK_CONCURRENCY_DATABASE_URL=postgres:///bodega_stock_concurrency
# STOCK_CONCURRENCY_ALLOW_DESTRUCTIVE_RESET=true
#
# DELIVERIES_CONCURRENCY_DATABASE_URL=postgres:///bodega_deliveries_concurrency
# DELIVERIES_CONCURRENCY_ALLOW_DESTRUCTIVE_RESET=true
#
# RECEIVING_CONCURRENCY_DATABASE_URL=postgres:///bodega_receiving_concurrency
# RECEIVING_CONCURRENCY_ALLOW_DESTRUCTIVE_RESET=true
#
# RATE_LIMIT_CONCURRENCY_DATABASE_URL=postgres:///bodega_rate_limit_concurrency
# RATE_LIMIT_CONCURRENCY_ALLOW_DESTRUCTIVE_RESET=true
#
# PERF_DATABASE_URL=postgres:///bodega_perf
# PERF_ALLOW_DESTRUCTIVE_RESET=true
#
# CAPTURE_DATABASE_URL=postgres:///bodega_capture
# CAPTURE_ALLOW_DESTRUCTIVE_RESET=true
# CAPTURE_PORT=3001


# ── Build / Docker ────────────────────────────────────────────────────────────
# ARG/ENV del Dockerfile — no van en .env.local, se listan aquí como referencia.
#
# NEXT_TELEMETRY_DISABLED=1
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
#
# Despliegue CI/GHCR (docker-compose.yml). Solo para substitución ${} del compose;
# no son variables de runtime de la app.
# GITHUB_REPOSITORY=chome/bodega   # ruta de la imagen en GHCR
# IMAGE_TAG=latest                 # tag/SHA de la imagen a desplegar
