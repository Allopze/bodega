# ─────────────────────────────────────────────────────────────────────────────
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia a .env.local para desarrollo o a .env para Docker Compose.
# Rellena los valores de tu entorno.
# [REQUERIDA] = el sistema no arranca sin ella.
# [Opcional]  = tiene valor por defecto en el código.
# ─────────────────────────────────────────────────────────────────────────────


# ── App ──────────────────────────────────────────────────────────────────────
# [Opcional] URL pública canónica. Se usa en links de correo
# cuando la request no lleva host. Por defecto infiere el origen de la request.
APP_URL=http://localhost:3001

# [Opcional] URL interna para que Playwright renderice PDFs sin pasar por proxy/CDN.
# En Docker producción debe quedar en loopback para evitar reescrituras externas.
PDF_RENDER_ORIGIN=http://127.0.0.1:3001

# [Opcional] URL base para NextAuth. AUTH_URL tiene precedencia sobre NEXTAUTH_URL.
AUTH_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001

# [REQUERIDA] Clave de firma y cifrado de sesión. Mínimo 32 caracteres.
# Genera con: openssl rand -hex 32
AUTH_SECRET=
# [Opcional] Secret anterior para rotación sin cerrar sesiones existentes.
# Déjalo solo mientras expiran las cookies antiguas. Soporta varios separados por coma.
AUTH_SECRET_PREVIOUS=
# [Opcional] Fallback para AUTH_SECRET (NextAuth lee AUTH_SECRET primero).
# Solo necesario si AUTH_SECRET no está definido.
NEXTAUTH_SECRET=


# ── Base de datos ────────────────────────────────────────────────────────────
# [REQUERIDA] URL completa de PostgreSQL.
# Ejemplo local por socket: postgres:///bodega
# Ejemplo TCP: postgres://usuario:clave@host:5432/bodega
DATABASE_URL=

# [Opcional] Ruta del socket Unix de PostgreSQL. Solo necesaria con peer auth
# (desarrollo local). No aplica al contenedor. Habitual en Debian/Ubuntu:
PGHOST=/var/run/postgresql

# [Docker Compose self-contained] Si DATABASE_URL está vacío, compose usa estas
# variables para crear y conectar al servicio `db`.
POSTGRES_DB=bodega
POSTGRES_USER=bodega
# [REQUERIDA en Docker self-contained] Genera una clave fuerte.
POSTGRES_PASSWORD=


# ── Correo electrónico (Resend) ───────────────────────────────────────────────
# [Opcional] Clave de API de Resend (https://resend.com/api-keys).
# Sin esta variable el sistema arranca pero queda silencioso (no envía correos).
# El remitente fijo es plataforma@portalchome.cl (dominio verificado en Resend).
# El interruptor global en /admin/correo-smtp también puede pausar los envíos.
RESEND_API_KEY=


# ── Almacenamiento de archivos ────────────────────────────────────────────────
# [Opcional] Ruta absoluta del volumen de adjuntos.
# Dev local: déjalo vacío → usa ./storage/
# Producción: ruta persistente fuera del contenedor, p.ej. /data/storage
STORAGE_PATH=
TAE_OCR_MAX_CONCURRENT=1


# ── Respaldos (Backup & Restore) ─────────────────────────────────────────────
# [Opcional] Directorio local donde se almacenan los respaldos temporales.
# Por defecto /srv/bodega/backups en producción.
BACKUP_DIR=

# [Opcional] Destino en Google Drive para los respaldos.
# Formato: <rclone-remote>:<ruta-en-drive>
# Requiere rclone configurado con Service Account (ver SETUP_GOOGLE_DRIVE_BACKUP.md).
# Vacío = respaldo solo local, sin subida a Drive.
GDRIVE_BACKUPS_DEST=

# [Opcional] Días de retención de respaldos locales y remotos.
RETENTION_DAYS=30

# [Opcional] Ruta del archivo de configuración de rclone.
# Por defecto $HOME/.config/rclone/rclone.conf.
# Solo necesaria si rclone.conf está en una ubicación no estándar.
RCLONE_CONFIG=

# [Opcional] Ruta alternativa para encontrar los scripts de backup en runtime.
# Solo necesaria si los scripts no están en el directorio estándar
# (ej: Docker standalone donde process.cwd() apunta a .next/standalone/).
BACKUP_SCRIPTS_PATH=

# ── Cifrado de datos sensibles de Prevención ────────────────────────────────
# [REQUERIDA antes de habilitar salud/casos reservados] Llave AES-256 en base64.
# Genera fuera del repositorio con: openssl rand -base64 32
# La app falla de forma cerrada si falta o no decodifica exactamente 32 bytes.
PREVENTION_DATA_ENCRYPTION_KEY=
# Versión lógica para rotación; no contiene la llave.
PREVENTION_DATA_ENCRYPTION_KEY_VERSION=v1


# ── Negocio ───────────────────────────────────────────────────────────────────
# [Opcional] Tasa de IVA como decimal. Por defecto 0.19 (19 % — Chile).
TAX_RATE=0.19

# [Opcional] Máximo de contextos Playwright activos para generación de PDF.
# Por defecto 2. Aumenta en máquinas con más RAM; reduce si ves OOM bajo carga.
PDF_MAX_CONCURRENT=2
# [Opcional] Binario Chromium del sistema para generación de PDF en Docker.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser


# ── Cron jobs ───────────────────────────────────────────────────────────────
# [REQUERIDA en producción] Secret compartido entre el scheduler externo
# (Vercel cron, GitHub Actions, etc.) y los endpoints `/api/cron/*`.
# Sin este valor los endpoints devuelven 500.
# Genera con: openssl rand -hex 32
# El cliente (curl, scheduler) debe enviarlo como header
# `Authorization: Bearer $CRON_SECRET`. La verificación usa
# `timingSafeEqual` para evitar timing attacks.
CRON_SECRET=

# ── Copec TCT/TAE ────────────────────────────────────────────────────────────
# Credenciales del portal de informes. Solo servidor; nunca usar NEXT_PUBLIC_.
COPEC_USERNAME=
COPEC_PASSWORD=
COPEC_SYNC_START_DATE=2020-01-01

# [Opcional] Email del usuario que recibe notificaciones de importación de
# registros Copec. Si no se configura, se omite el envío de notificación.
COPEC_SYNC_IMPORTER_EMAIL=


# ── Seed (maestros base) ─────────────────────────────────────────────────────
# Solo se usa al correr: pnpm db:seed. Carga faenas/trabajadores y catálogo EPP.
# [Opcional] Datos del usuario administrador que se crea durante el seed.
# Si no se configuran, el seed usa valores por defecto.
SEED_ADMIN_NAME=Nombre del administrador
SEED_ADMIN_EMAIL=admin@ejemplo.cl
# [REQUERIDA en producción] Contraseña del administrador. En producción no se
# permite la contraseña por defecto; debe configurarse explícitamente.
SEED_ADMIN_PASSWORD=
# [Opcional] Si es "true", permite usar la contraseña por defecto del seed
# incluso en producción (útil solo para desarrollo). Por defecto false.
SEED_ALLOW_DEFAULT_PASSWORD=false

# [Opcional] Si es "true", valida la configuración del seed sin escribir nada
# en la base de datos. Útil en CI/pre-deploy.
SEED_DRY_RUN=false


# ── Observabilidad ────────────────────────────────────────────────────────────
# [Opcional] DSN de Sentry para errores de servidor. Vacío = tracking deshabilitado.
SENTRY_DSN=
# [Opcional] DSN de Sentry para errores de cliente (NEXT_PUBLIC_ porque se usa en el browser).
NEXT_PUBLIC_SENTRY_DSN=
# [Opcional] Organización y proyecto de Sentry para source maps.
SENTRY_ORG=
SENTRY_PROJECT=

# [Vercel nativo] SHA del commit desplegado. Vercel lo inyecta automáticamente;
# fuera de Vercel se ignora. Se usa para versionar los respaldos.
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=


# ── Testing (E2E / rendimiento / capturas) ───────────────────────────────────
# Override DATABASE_URL for E2E test runs (defaults to bodega_e2e if unset)
# E2E_DATABASE_URL=postgres:///bodega_e2e
# E2E_ALLOW_DESTRUCTIVE_RESET=true

# Performance benchmarks
# PERF_DATABASE_URL=postgres:///bodega_perf_test
# PERF_ALLOW_DESTRUCTIVE_RESET=true

# Audit screenshots (scripts/capture-all-routes.ts)
# CAPTURE_DATABASE_URL=postgres:///bodega_capture
# CAPTURE_ALLOW_DESTRUCTIVE_RESET=true
# CAPTURE_PORT=3127
# CAPTURE_OUTPUT_DIR=


# ── Testing (Postgres — tests de módulos de Prevención) ────────────────────
# Cada suite de test de Prevención usa su propia BD para aislar datos.
# Se crean bajo demanda con esquema compartido; no requieren seed previo.
# Si no se configuran, las suites usan DATABASE_URL y lanzan advertencia.

# Riesgos legales
# PREVENTION_RISK_DATABASE_URL=postgres:///bodega_test_risk
# PREVENTION_RISK_ALLOW_DESTRUCTIVE_RESET=true

# Inspecciones
# PREVENTION_INSPECTIONS_DATABASE_URL=postgres:///bodega_test_inspections
# PREVENTION_INSPECTIONS_ALLOW_DESTRUCTIVE_RESET=true

# Capacitación
# PREVENTION_TRAINING_DATABASE_URL=postgres:///bodega_test_training
# PREVENTION_TRAINING_ALLOW_DESTRUCTIVE_RESET=true

# Permisos de trabajo (LOTO)
# PREVENTION_PERMITS_DATABASE_URL=postgres:///bodega_test_permits
# PREVENTION_PERMITS_ALLOW_DESTRUCTIVE_RESET=true

# Higiene industrial
# PREVENTION_HYGIENE_DATABASE_URL=postgres:///bodega_test_hygiene
# PREVENTION_HYGIENE_ALLOW_DESTRUCTIVE_RESET=true

# Indicadores
# PREVENTION_INDICATORS_DATABASE_URL=postgres:///bodega_test_indicators
# PREVENTION_INDICATORS_ALLOW_DESTRUCTIVE_RESET=true

# Concurrencia — recepción
# RECEIVING_CONCURRENCY_DATABASE_URL=postgres:///bodega_test_receiving
# RECEIVING_CONCURRENCY_ALLOW_DESTRUCTIVE_RESET=true

# Concurrencia — entregas
# DELIVERIES_CONCURRENCY_DATABASE_URL=postgres:///bodega_test_deliveries
# DELIVERIES_CONCURRENCY_ALLOW_DESTRUCTIVE_RESET=true

# Alcance de trabajadores
# TRABAJADORES_SCOPE_DATABASE_URL=postgres:///bodega_test_workers
# TRABAJADORES_SCOPE_ALLOW_DESTRUCTIVE_RESET=true
