# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/.tmp

# next.js
/.next/
/out/

# production
/build
/storage

# local sqlite runtime
/db/*.db
/db/*.db-shm
/db/*.db-wal

# misc
.DS_Store
*.pem

# datos de trabajadores con PII (RUT/nombres) — no debe versionarse
/trabajadores_por_faena_actualizado.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
._.DS_Store

# tool artifacts (local only)
.VSCodeCounter/
.commandcode/

/audit
/ui-audit
.env.local

/releases
/Registros SG-SST

# tesseract.js descarga el modelo de idioma en el cwd en runtime (~5MB) si no
# se configura langPath/cachePath — artefacto regenerable, no es código fuente
*.traineddata
