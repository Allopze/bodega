# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/.tmp
# Blobs intermedios de la cobertura combinada (npm run test:coverage:all)
/.vitest-reports

# next.js
/.next/
/out/

# production
/build
/storage

# local sqlite runtime
/db/*.db
/db/*.db-shm
/db/*.db-wal

# misc
.DS_Store
._*
*.pem

# datos de trabajadores con PII (RUT/nombres) — no debe versionarse
/trabajadores_por_faena_actualizado.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
._.DS_Store

# tool artifacts (local only)
.VSCodeCounter/
.commandcode/
/artifacts/
# índice local de CodeGraph (~127 MB, se regenera solo)
.codegraph/

/audit
/ui-audit
.env.local
.mimocode/

/releases
/Registros SG-SST

# tesseract.js descarga el modelo de idioma en el cwd en runtime (~5MB) si no
# se configura langPath/cachePath — artefacto regenerable, no es código fuente
*.traineddata

# Planillas y documentos de calibración/auditoría
/docs/planillas/

# Documentos de la operación (SGI) — no se versionan
/docs/SGI Chome_2026/

.agents
/checklists
# Volcados de pg_dump. Traen datos personales de producción (nombres y RUT de
# la dotación): en el repositorio quedarían en el historial para siempre y
# rehacerlo exige reescribirlo. Los respaldos van por /admin/backups, no por git.
backup-*.sql
*.dump

/anexos
# Environment files may contain credentials. Keep only the sanitized template.
*.env
*.env.*
.env
.env.*
!.env.example

docs/facturas_apro_treck_kupfer